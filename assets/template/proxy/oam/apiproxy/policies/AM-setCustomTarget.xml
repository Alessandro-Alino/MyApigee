<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-setCustomTarget">
		<DisplayName>AM-setCustomTarget</DisplayName>
		<Properties/>
		<AssignVariable>
				<Name>customTarget</Name>
				<Template>{request.queryparam.be}</Template>
		</AssignVariable>
		<AssignVariable>
				<Name>target.copy.pathsuffix</Name>
				<Template>false</Template>
		</AssignVariable>
		<AssignVariable>
				<Name>target.url</Name>
				<Template>https://{customTarget}{proxy.pathsuffix}</Template>
		</AssignVariable>
		<IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>