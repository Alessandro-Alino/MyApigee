<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-setCustomTargetFromReferer">
		<DisplayName>AM-setCustomTargetFromReferer</DisplayName>
		<Properties/>
		<AssignVariable>
				<Name>customTargetReferer</Name>
				<Template>{request.header.Referer}</Template>
		</AssignVariable>
		<AssignVariable>
				<Name>regex</Name>
				<Template>^.*[?&amp;]be=([^&amp;]+).*?$</Template>
		</AssignVariable>
		<AssignVariable>
				<Name>customTarget</Name>
				<Template>{replaceFirst(customTargetReferer,regex,$1)}</Template>
		</AssignVariable>
		<AssignVariable>
				<Name>target.url</Name>
				<Template>https://{customTarget}{proxy.pathsuffix}</Template>
		</AssignVariable>
		<IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>