<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault continueOnError="false" enabled="true" name="RF-flowNotFound">
  <DisplayName>RF-flowNotFound</DisplayName>
  <Properties/>
  <FaultResponse>
    <Set>
      <Payload contentType="application/json"/>
      <StatusCode>404</StatusCode>
      <ReasonPhrase>Flow Not Found</ReasonPhrase>
    </Set>
  </FaultResponse>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
